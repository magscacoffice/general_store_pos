<Window x:Class="KhanBabaPos.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Khan Baba POS" Width="1280" Height="800" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#F3F6F4" Loaded="Window_Loaded">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE5E0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#20342D"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowHeight" Value="38"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAF9"/></Style>
</Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#173B32"><DockPanel Margin="18"><StackPanel DockPanel.Dock="Top" Margin="0,8,0,28"><TextBlock Text="KHAN BABA" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="GENERAL STORE" Foreground="#B8D4C8" FontSize="11" FontWeight="SemiBold" Margin="1,3,0,0"/></StackPanel><StackPanel><TextBlock Text="WORKSPACE" Foreground="#A9C4B8" FontSize="10" FontWeight="Bold" Margin="4,0,0,12"/><Button Content="▣   New Sale" Background="#2D594B" Foreground="White" BorderBrush="#527667" FontWeight="SemiBold" Click="NewSale_Click"/><Button Content="▤   Inventory" Click="ComingSoon_Click"/><Button Content="▧   Sales History" Click="ComingSoon_Click"/><Button Content="▥   Purchases" Click="ComingSoon_Click"/><Button Content="◫   Customer Khata" Click="ComingSoon_Click"/><Button Content="▦   Reports" Click="ComingSoon_Click"/><Button Content="⚙   Settings" Click="ComingSoon_Click"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,4"><TextBlock Text="NATIVE WINDOWS CLIENT" Foreground="#B8D4C8" FontSize="10" FontWeight="Bold"/><TextBlock Text=".NET WPF • Local-first" Foreground="#B8D4C8" FontSize="10" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
<Grid Grid.Column="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="New Sale" FontSize="26" FontWeight="Bold" Foreground="#1C3028"/><TextBlock Text="Scan a barcode or search products to add them to the current bill." Foreground="#65736C" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="White" BorderBrush="#DCE5E0" BorderThickness="1" CornerRadius="9" Padding="12,8" VerticalAlignment="Center"><StackPanel><TextBlock Text="DATABASE" FontSize="9" FontWeight="Bold" Foreground="#728078"/><TextBlock x:Name="DatabaseStatusText" Text="Checking…" FontSize="12" FontWeight="SemiBold" Foreground="#52615B"/></StackPanel></Border></Grid>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Grid.ColumnSpan="2" Background="White" BorderBrush="#DCE5E0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="25" Foreground="#477261" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="ScannerBox" Grid.Column="1" Height="42" FontSize="17" BorderThickness="0" VerticalContentAlignment="Center" ToolTip="Barcode scanner input or product search" TextChanged="ScannerBox_TextChanged" KeyDown="ScannerBox_KeyDown" AutomationProperties.Name="Barcode scanner and product search"/><TextBlock Grid.Column="1" Text="Scan barcode or type product name…" Foreground="#9AA69F" FontSize="15" IsHitTestVisible="False" VerticalAlignment="Center" Margin="4,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ScannerBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border Grid.Column="2" Background="#EAF2EE" CornerRadius="6" Padding="10,7" VerticalAlignment="Center"><TextBlock Text="SCANNER READY" Foreground="#28634C" FontSize="10" FontWeight="Bold"/></Border></Grid></Border>
<Border Grid.Row="1" Background="White" BorderBrush="#DCE5E0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,16,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBlock Text="Current Bill" FontSize="17" FontWeight="Bold" Foreground="#20342D"/><TextBlock x:Name="CartCountText" DockPanel.Dock="Right" Text="0 items" Foreground="#728078" VerticalAlignment="Center"/></DockPanel><DataGrid x:Name="CartGrid" Grid.Row="1" ItemsSource="{Binding CartLines}" SelectionMode="Single" SelectionUnit="FullRow"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn Header="Rate" Binding="{Binding Price, StringFormat=N2}" Width="95" IsReadOnly="True"/><DataGridTextColumn Header="Amount" Binding="{Binding LineTotal, StringFormat=N2}" Width="105" IsReadOnly="True"/></DataGrid.Columns></DataGrid><DockPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="Remove selected" Click="RemoveSelected_Click" Margin="0"/><Button Content="Clear bill" Click="ClearBill_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/></DockPanel></Grid></Border>
<StackPanel Grid.Column="1" Grid.Row="1"><Border Background="White" BorderBrush="#DCE5E0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14"><StackPanel><TextBlock Text="Product suggestions" FontSize="16" FontWeight="Bold" Foreground="#20342D"/><TextBlock x:Name="SearchStatusText" Text="Ready for barcode scan." Foreground="#728078" FontSize="12" Margin="0,5,0,10"/><ListBox x:Name="SuggestionsList" Height="190" BorderThickness="0" SelectionChanged="SuggestionsList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#20342D"/><TextBlock Text="{Binding Barcode}" FontSize="11" Foreground="#77847D"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Price, StringFormat=N2}" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding StockLabel}" FontSize="10" Foreground="#77847D"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border><Border Background="#173B32" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="BILL SUMMARY" Foreground="#B8D4C8" FontSize="10" FontWeight="Bold"/><TextBlock Text="Subtotal" Foreground="#D9E6E0" Margin="0,16,0,3"/><TextBlock x:Name="SubtotalText" Text="Rs. 0.00" Foreground="White" FontSize="27" FontWeight="Bold"/><TextBlock Text="Discount and checkout will be connected after business-rule parity is completed." TextWrapping="Wrap" Foreground="#B8D4C8" FontSize="11" Margin="0,12,0,16"/><Button Content="Checkout (not enabled yet)" IsEnabled="False" HorizontalContentAlignment="Center" Background="#DCE9E2" Foreground="#173B32" FontWeight="Bold" Margin="0"/></StackPanel></Border><TextBlock Text="This phase is read-only against the existing database. Cart contents are temporary and are not saved as a sale." TextWrapping="Wrap" Foreground="#77847D" FontSize="11" Margin="4,12,4,0"/></StackPanel>
</Grid></Grid></Grid></Grid></Window>