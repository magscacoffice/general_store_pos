rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(storeId) {
      return /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid);
    }

    function activeMember(storeId) {
      return signedIn()
        && exists(memberPath(storeId))
        && get(memberPath(storeId)).data.active == true;
    }

    function storeAdmin(storeId) {
      return activeMember(storeId)
        && get(memberPath(storeId)).data.role == 'admin';
    }

    match /stores/{storeId}/members/{userId} {
      allow get: if signedIn() && request.auth.uid == userId
        || storeAdmin(storeId);
      allow list: if storeAdmin(storeId);
      allow create, update, delete: if storeAdmin(storeId);
    }

    // Shared store records are readable/writable only by active members.
    // Keep all shared POS collections under /stores/{storeId}/... .
    match /stores/{storeId}/{document=**} {
      allow read, write: if activeMember(storeId);
    }

    // Legacy root-level collections remain closed. They will be migrated
    // to the store-scoped path before realtime sync is enabled.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
